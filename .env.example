IMAGE_REPO_URL=https://github.com/OWNER/REPO
# A GitHub folder URL also works, for example:
# https://github.com/OWNER/REPO/tree/main/public/foto
# Fine-grained PAT needs Contents: Read and write access on the image repository.
IMAGE_REPO_PAT=github_pat_xxx
# folder inside the repo holding project images (relative to repo root); default: project.
# Use public/foto when the files are in the app repository's public/foto folder.
IMAGE_PROJECT_PATH=public/foto
# admin panel login at /admin
ADMIN_PASSWORD=change-me
# site url for og/metadata
NEXT_PUBLIC_SITE_URL=https://hilmi.my.id
